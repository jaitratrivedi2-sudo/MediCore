# MediCore - Git Ignore Rules
# Security: Strict exclusion of secrets and environment credentials
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Python Environments & Artifacts
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Node.js & Next.js Artifacts
node_modules/
.npm/
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
out/
.pnp
.pnp.js

# Databases & Runtime State
*.sqlite
*.sqlite3
*.db
*.log
logs/
*.pid
*.seed
*.pid.lock

# Certificates & Private Keys
*.pem
*.key
*.crt
*.pfx
*.p12

# OS Artifacts
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
